<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Enable"</Description>
      <Options moHideChildren="1"/>
      <Color>C08000</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : tld.exe
  Version:
  Date   : 2026-11-08
  Author : sub1to
}

[ENABLE]
{$lua}
if syntaxcheck then
    return
end

if process and readInteger(process) ~= 0 then
    mono_initialize()
    LaunchMonoDataCollector()
else
    print("No process detected")
    error("No process detected")
end

local structNames = {
    "EconomyManager",
    --"Unity.Netcode.NetworkVariable`1",
    "BipolarReputationManager",
    "TimeManager",
    "ProgressionManager",
}

function getStructByName(structName)
	local n = getStructureCount() - 1

	for i = 0, n do
		local struct = getStructure(i)
		if struct.Name == structName then
            return struct
        end
	end

	return nil
end

function getNamespaceAndName(fullName)
    local ns, name = fullName:match("^(.*)%.([^%.]+)$")
    if ns then
        return ns, name
    end
    return "", fullName
end

function sanitizeStructName(fullName)
    local result = fullName:gsub("%.", "$")
    return result:gsub("`", "$")
end

function resolveStruct(fullName)
    local sanitizedName = sanitizeStructName(fullName)
    local struct = getStructByName(sanitizedName)

    if struct then
        struct.removeFromGlobalStructureList()
    end

    struct = createStructure(sanitizedName)

    local ns, name = getNamespaceAndName(fullName)
    local classId = mono_findClass(ns, name)

    if classId == nil then
        local msg = "Class " .. fullName .. " (" .. sanitizedName .. ") not found"
        print(msg)
        error(msg)
    end

    local fields = mono_class_enumFields(classId, true)
    for i, field in pairs(fields) do
      if not field.isStatic then
          local element = struct.addElement()
          element.Offset = field.offset
          element.Name = field.name
          element.Vartype = field.type
      end
    end

    struct.addToGlobalStructureList()
    print("Updated struct " .. sanitizedName)
end

print("\nUpdating structs..")
for i, structName in pairs(structNames) do
    resolveStruct(structName)
end

{$asm}

[DISABLE]

{$lua}
if syntaxcheck then
    return
end

local n = getStructureCount() - 1

for i = n, 0, -1 do
    local struct = getStructure(i)
    if struct then
        struct.removeFromGlobalStructureList()
    end
end

print("Removed all structs")

{$asm}


</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>20</ID>
          <Description>"EconomyManager"</Description>
          <Options moHideChildren="1"/>
          <Color>008000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : I Know a Guy.exe
  Version:
  Date   : 2026-11-10
  Author : sub1to

  class EconomyManager : public ::Unity::Netcode::NetworkBehaviour

    ::Unity::Netcode::NetworkVariable_1* networkMoney; // Offset: 0xd0
    ::Unity::Netcode::NetworkVariable_1* networkCrypto; // Offset: 0xd8
}
[ENABLE]
{$lua}
if syntaxcheck then return end
if economy_manager_mem then
  unregisterSymbol("economy_manager_ptr")
  deAlloc(economy_manager_mem)
  economy_manager_mem = nil
end

local classId = mono_findClass("", "EconomyManager")
if classId == nil then
  error("EconomyManager not found")
end

economy_manager_mem = allocateMemory(8)
registerSymbol("economy_manager_ptr", economy_manager_mem)

local fields = mono_class_enumFields(classId, true)
for i in pairs(fields) do
  if fields[i].isStatic and fields[i].name == "_instance" then
    local val = mono_class_getStaticFieldValue(classId, fields[i].field)
    writeQword(economy_manager_mem, val or 0)
    return
  end
end
error("_instance not found")

{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end

unregisterSymbol("economy_manager_ptr")
if economy_manager_mem then
  deAlloc(economy_manager_mem)
  economy_manager_mem = nil
end
{$asm}
</AssemblerScript>
