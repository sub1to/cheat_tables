{$asm}
define(hook,StardewValley.Farmer::getMovementSpeed)
//assert(hook,57 56 48 83 ec ?)

alloc(newmem,$1000,hook)

label(code)
label(returnhere)

label(get_movement_speed_bytes)
registersymbol(get_movement_speed_bytes)

label(get_movement_speed_value)
registersymbol(get_movement_speed_value)

newmem:
get_movement_speed_bytes:
  readMem(hook,6)
  jmp returnhere

get_movement_speed_value:
  dd (float)2.0

code:
  sub rsp, 28
  call get_movement_speed_bytes
  add rsp, 28
  mulss xmm0, [get_movement_speed_value]
  ret

hook:
  jmp code
  nop
  returnhere:

