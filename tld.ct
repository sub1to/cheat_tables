        <CheatEntry>
          <ID>9153</ID>
          <Description>"Force Player Map Icon"</Description>
          <Color>0000FF</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

mono_initialize()
LaunchMonoDataCollector()

local classId = mono_findClass('Assembly-CSharp.dll', 'Panel_Map')
if classId == nil then print('class not found') return end
print(classId)
local fields = mono_class_enumFields(classId, true)
for i in pairs(fields) do
  if fields[i].isStatic and fields[i].name == 's_ForceShowPlayerIcon' then
    print('s_ForceShowPlayerIcon: ' .. mono_class_getStaticFieldValue(classId, fields[i].field))
    mono_class_setStaticFieldValue(classId, fields[i].field, 1)
  end
end

{$asm}

[DISABLE]

</AssemblerScript>
