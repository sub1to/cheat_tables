}

[ENABLE]

aobscanmodule(_get_base_ptr,FindTheNeedle.exe,48 8B 96 90 02 00 00 45) // should be unique
alloc(newmem,$1000,_get_base_ptr)

label(code)
label(return)
label(pBasePtr)

registersymbol(_get_base_ptr)
registersymbol(pBasePtr)

newmem:
  mov rdx,[rsi+00000290]
  mov [pBasePtr], rdx

code:
  //mov rdx,[rsi+00000290]
  jmp return

pBasePtr:
  dq 0

_get_base_ptr:
  jmp newmem
  nop 2
return:


[DISABLE]

_get_base_ptr:
